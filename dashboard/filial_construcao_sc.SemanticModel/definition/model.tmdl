model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_ProTooling = ["DevMode"]

ref table Municipio
ref table Fato2022
ref table Cenario
ref table Componente
ref table Sensibilidade
ref table Contexto
ref table Historico
