table Fato2022
	lineageTag: 7bf65631-9ac1-520e-b513-7298d8545133

	measure 'Domicílios ocupados' = IF(HASONEVALUE(Municipio[id_municipio]), MAX(Fato2022[domicilios]))
		formatString: #,0
		lineageTag: eb49110d-d86f-4f93-a4a1-372c25dcb123

	measure 'População residente' = IF(HASONEVALUE(Municipio[id_municipio]), MAX(Fato2022[populacao]))
		formatString: #,0
		lineageTag: 0579ba2e-2017-43d5-9346-ceebeb8d1358

	measure 'Rendimento mediano' = IF(HASONEVALUE(Municipio[id_municipio]), MAX(Fato2022[renda]))
		formatString: "R$ "#,0.00
		lineageTag: 32c9f693-1718-4569-a978-95ca1cfbbbbf

	measure 'Unidades locais' = IF(HASONEVALUE(Municipio[id_municipio]), MAX(Fato2022[concorrentes]))
		formatString: #,0
		lineageTag: b75e9e68-54ec-4f55-be1f-6330735fbe82

	measure 'Taxa de ocupação' = IF(HASONEVALUE(Municipio[id_municipio]), MAX(Fato2022[taxa_ocupacao]))
		formatString: 0.0"%"
		lineageTag: fe07b5da-d766-4810-aa03-9b78a64434ba

	measure 'Saturação por 10 mil' = IF(HASONEVALUE(Municipio[id_municipio]), MAX(Fato2022[saturacao]))
		formatString: #,0.0
		lineageTag: b52f99c7-7e66-4409-a7cb-de00eb1d21c5

	measure 'Score domicílios' = MAX(Fato2022[score_domicilios])
		formatString: 0.0
		lineageTag: c783b5ab-586e-4739-93f0-d2f59a386e90

	measure 'Score renda' = MAX(Fato2022[score_renda])
		formatString: 0.0
		lineageTag: 578fcb2d-8315-478b-af77-00e7b6eced4e

	measure 'Score saturação' = MAX(Fato2022[score_saturacao])
		formatString: 0.0
		lineageTag: 715afdba-dd67-4e0f-b0e9-7fdf01028264

	measure 'Score ocupação' = MAX(Fato2022[score_ocupacao])
		formatString: 0.0
		lineageTag: 564bd9b1-46ea-46e4-8842-bc49ae7927bb

	measure peso_mercado = SELECTEDVALUE(Cenario[peso_mercado], 40)
		formatString: 0"%"
		lineageTag: 67be903e-1f9b-4111-9d3b-b73b013061df

	measure peso_renda = SELECTEDVALUE(Cenario[peso_renda], 30)
		formatString: 0"%"
		lineageTag: 0391f1ef-066a-4e4f-91e7-c3699e3dc4d8

	measure peso_saturacao = SELECTEDVALUE(Cenario[peso_saturacao], 20)
		formatString: 0"%"
		lineageTag: c4a6189a-ab83-484e-9247-611266c5f56f

	measure peso_ocupacao = SELECTEDVALUE(Cenario[peso_ocupacao], 10)
		formatString: 0"%"
		lineageTag: 833ebee7-29df-4ebe-993c-efe5703b1edd

	measure 'Cenário ativo' = SELECTEDVALUE(Cenario[cenario], "Referência")
		lineageTag: bab682b3-6dc6-4ec7-a620-bde974ab7605

	measure 'Pesos ativos' = "Mercado " & FORMAT([peso_mercado],"0") & "% · Renda " & FORMAT([peso_renda],"0") & "% · Saturação " & FORMAT([peso_saturacao],"0") & "% · Ocupação " & FORMAT([peso_ocupacao],"0") & "%"
		lineageTag: 9381138a-a163-416c-9df2-a52e048792d3

	measure Índice = IF(HASONEVALUE(Municipio[id_municipio]) && MAX(Fato2022[elegivel]) = 1, DIVIDE([Score domicílios]*[peso_mercado] + [Score renda]*[peso_renda] + [Score saturação]*[peso_saturacao] + [Score ocupação]*[peso_ocupacao], [peso_mercado]+[peso_renda]+[peso_saturacao]+[peso_ocupacao]))
		formatString: 0.0
		lineageTag: 7457eb90-0734-4faf-8b15-f89319b812d0

	measure 'Índice municipal' = IF(HASONEVALUE(Municipio[id_municipio]), [Índice])
		formatString: 0.0" /100"
		lineageTag: 4c2c6a83-2312-465f-afd3-3b9c7944267e

	measure Elegíveis = CALCULATE(COUNTROWS(Fato2022), REMOVEFILTERS(Municipio), Fato2022[elegivel]=1)
		formatString: 0
		lineageTag: 507fedac-768c-4704-aa2b-16cae9b80afc

	measure Cobertura = FORMAT([Elegíveis],"0") & " / 295"
		lineageTag: 9334d7db-1f46-41bf-a305-382fd54253c7

	measure Ano = 2022
		formatString: 0
		lineageTag: 8731ac9a-2fb1-43bf-9f28-d84e8024ca34

	measure Ranking =
			VAR atual=[Índice]
			RETURN IF(HASONEVALUE(Municipio[id_municipio]) && NOT ISBLANK(atual), RANKX(FILTER(ALL(Municipio), CALCULATE(MAX(Fato2022[elegivel]))=1), [Índice], atual, DESC, DENSE))
		formatString: 0
		lineageTag: 1507e5b4-3299-41db-86bb-b2b7d4bd092d

	measure 'Posição estadual' = IF(HASONEVALUE(Municipio[id_municipio]), FORMAT([Ranking],"0") & " / " & FORMAT([Elegíveis],"0"), "Selecione um município")
		lineageTag: 9720241f-05bd-4de0-b631-6ccd23ac2d55

	measure 'Índice Top 10' =
			VAR municipioSelecionado=SELECTEDVALUE(Municipio[id_municipio])
			VAR topdez=TOPN(10,FILTER(ALL(Municipio),CALCULATE(MAX(Fato2022[elegivel]))=1),[Índice],DESC,Municipio[id_municipio],ASC)
			RETURN IF(CONTAINS(topdez,Municipio[id_municipio],municipioSelecionado),[Índice])
		formatString: 0.0
		lineageTag: 66de7f27-5317-4ade-a6d9-00a980ff0bbc

	measure 'Município líder' =
			VAR t=TOPN(1,FILTER(ALL(Municipio),CALCULATE(MAX(Fato2022[elegivel]))=1),[Índice],DESC,Municipio[id_municipio],ASC)
			RETURN IF([Elegíveis]=0,"Sem base validada para recomendar",CONCATENATEX(t,Municipio[municipio],""))
		lineageTag: 829af4da-8b34-4c74-a6cb-ba4ddab827b6

	measure 'Índice do líder' = MAXX(FILTER(ALL(Municipio),CALCULATE(MAX(Fato2022[elegivel]))=1),[Índice])
		formatString: 0.0" /100"
		lineageTag: e7d97896-1f59-4ab6-bbb1-eef50cf22b90

	measure Veredito =
			VAR cidade=TOPN(1,FILTER(ALL(Municipio),CALCULATE(MAX(Fato2022[elegivel]))=1),[Índice],DESC,Municipio[id_municipio],ASC)
			VAR nome=CONCATENATEX(cidade,Municipio[municipio],"")
			VAR fatores=CALCULATETABLE(UNION(ROW("Fator","Mercado residencial","Score",[Score domicílios],"Pontos",DIVIDE([Score domicílios]*[peso_mercado],[peso_mercado]+[peso_renda]+[peso_saturacao]+[peso_ocupacao])),ROW("Fator","Rendimento do trabalho","Score",[Score renda],"Pontos",DIVIDE([Score renda]*[peso_renda],[peso_mercado]+[peso_renda]+[peso_saturacao]+[peso_ocupacao])),ROW("Fator","Menor saturação","Score",[Score saturação],"Pontos",DIVIDE([Score saturação]*[peso_saturacao],[peso_mercado]+[peso_renda]+[peso_saturacao]+[peso_ocupacao])),ROW("Fator","Ocupação 14+","Score",[Score ocupação],"Pontos",DIVIDE([Score ocupação]*[peso_ocupacao],[peso_mercado]+[peso_renda]+[peso_saturacao]+[peso_ocupacao]))),cidade)
			VAR motivos=CONCATENATEX(TOPN(2,fatores,[Pontos],DESC,[Fator],ASC),[Fator] & " (" & FORMAT([Pontos],"0.0") & " pts)"," e ",[Pontos],DESC)
			VAR empates=COUNTROWS(FILTER(ALL(Municipio),CALCULATE(MAX(Fato2022[elegivel]))=1 && ABS([Índice]-[Índice do líder])<0.000000001))
			RETURN IF([Elegíveis]=0,"Sem base validada para recomendar",nome & " lidera " & [Cenário ativo] & " · 2022 · " & FORMAT([Índice do líder],"0.0") & "/100." & IF(empates>1," Empate no topo; ordem técnica por código IBGE.","") & UNICHAR(10) & "Maiores contribuições: " & motivos & "." & UNICHAR(10) & "Prioridade para estudo comercial; custos, logística e retorno financeiro não foram estimados.")
		lineageTag: 7f00985b-6c46-4eb1-ace6-45d30ba9eda0

	measure 'Resumo municipal' =
			VAR fatores=UNION(ROW("Fator","Mercado residencial","Score",[Score domicílios],"Pontos",DIVIDE([Score domicílios]*[peso_mercado],[peso_mercado]+[peso_renda]+[peso_saturacao]+[peso_ocupacao])),ROW("Fator","Rendimento do trabalho","Score",[Score renda],"Pontos",DIVIDE([Score renda]*[peso_renda],[peso_mercado]+[peso_renda]+[peso_saturacao]+[peso_ocupacao])),ROW("Fator","Menor saturação","Score",[Score saturação],"Pontos",DIVIDE([Score saturação]*[peso_saturacao],[peso_mercado]+[peso_renda]+[peso_saturacao]+[peso_ocupacao])),ROW("Fator","Ocupação 14+","Score",[Score ocupação],"Pontos",DIVIDE([Score ocupação]*[peso_ocupacao],[peso_mercado]+[peso_renda]+[peso_saturacao]+[peso_ocupacao])))
			VAR forte=CONCATENATEX(TOPN(1,fatores,[Score],DESC,[Fator],ASC),[Fator] & " (" & FORMAT([Score],"0.0") & "/100)","")
			VAR fraco=CONCATENATEX(TOPN(1,fatores,[Score],ASC,[Fator],ASC),[Fator] & " (" & FORMAT([Score],"0.0") & "/100)","")
			RETURN IF(NOT HASONEVALUE(Municipio[id_municipio]),"Selecione um município pelo nome para avaliar seus indicadores.",IF(MAX(Fato2022[elegivel])<>1,"Índice indisponível: componente ausente; ausência não é zero.",SELECTEDVALUE(Municipio[municipio]) & " · " & FORMAT([Índice],"0.0") & "/100 · " & [Cenário ativo] & UNICHAR(10) & "Ponto forte relativo: " & forte & "." & UNICHAR(10) & "Menor score relativo: " & fraco & ". Pontuação estadual; não estima retorno."))
		lineageTag: 100590be-74ba-4b22-9321-9603cfbece0e

	measure Contribuição = IF(HASONEVALUE(Municipio[id_municipio]) && MAX(Fato2022[elegivel])=1,SWITCH(SELECTEDVALUE(Componente[componente]),"Mercado residencial",DIVIDE([Score domicílios]*[peso_mercado],[peso_mercado]+[peso_renda]+[peso_saturacao]+[peso_ocupacao]),"Rendimento do trabalho",DIVIDE([Score renda]*[peso_renda],[peso_mercado]+[peso_renda]+[peso_saturacao]+[peso_ocupacao]),"Menor saturação",DIVIDE([Score saturação]*[peso_saturacao],[peso_mercado]+[peso_renda]+[peso_saturacao]+[peso_ocupacao]),"Ocupação 14+",DIVIDE([Score ocupação]*[peso_ocupacao],[peso_mercado]+[peso_renda]+[peso_saturacao]+[peso_ocupacao])))
		formatString: 0.0
		lineageTag: 6099f1df-a61d-48d8-aa76-2e5046f6ec50

	measure 'Sem histórico' = "Série comparável de domicílios ainda indisponível." & UNICHAR(10) & "Apenas 2022 está validado. A série anterior usa outro universo."
		lineageTag: 771e15e5-c648-4f58-95bb-448c719efd5d

	measure Rodapé = "IBGE · base 2022 · " & [Cenário ativo] & " · Pontuação relativa; não é previsão de retorno."
		lineageTag: 3ad4fdd9-3f67-4bc9-b3bf-187cdd4bc0e4

	measure Subtítulo = "Base 2022 · Cenário " & [Cenário ativo] & " · " & [Pesos ativos]
		lineageTag: 588053ee-f80a-437b-82ed-074f5c965898

	measure 'Unidades locais no ano' = IF(HASONEVALUE(Municipio[id_municipio]), SUM(Historico[concorrentes]))
		formatString: #,0
		lineageTag: 2e115320-b8d4-422a-a857-a7b7e7a66a42

	measure 'Valor contextual' = IF(HASONEVALUE(Municipio[id_municipio]), SELECTEDVALUE(Contexto[valor]))
		lineageTag: 538e0536-e3df-4119-8087-87118acd7ee9

